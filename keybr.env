# Keybr Docker Instance Configuration
APP_URL=http://localhost:3000/
COOKIE_DOMAIN=localhost
COOKIE_SECURE=false

# Data directory for persistent storage (Docker volume mount)
DATA_DIR=/root/.local/state/keybr

# Database configuration (SQLite for local use)
DATABASE_CLIENT=sqlite
DATABASE_FILENAME=/root/.local/state/keybr/database.sqlite

# Mail configuration (disabled for local use)
MAIL_DOMAIN=localhost
MAIL_KEY=
MAIL_FROM_ADDRESS=keybr@localhost
MAIL_FROM_NAME=Keybr Docker

# Production logging
NODE_ENV=production